version=4
# Track upstream git tags directly (robust against GitHub's archive URL layout
# and pre-release tags). uversionmangle maps rc/alpha/beta tags to a Debian
# pre-release (~) ordering so 0.9.0~rc1 < 0.9.0.
opts="mode=git, pgpmode=none, \
uversionmangle=s/(\d)[_.\-]?(alpha|beta|rc|pre|preview)[.\-]?(\d*)$/$1~$2$3/" \
https://github.com/ggrv-intp/intp.git \
refs/tags/v?(\d\S+)
